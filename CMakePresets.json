{
    "version": 6,
    "configurePresets": [
        {
            "name": "release",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                            "CMAKE_BUILD_TYPE": "Release",
                            "CMAKE_INSTALL_PREFIX":"${sourceDir}/build/release",
                            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
        },

        {
            "name": "debug",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE":"Debug",
                                "CMAKE_INSTALL_PREFIX":"${sourceDir}/build/debug",
                                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
        },

        {
            "name": "sanitize",
            "binaryDir": "${sourceDir}/build/sanitize",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS" : "-fsanitize=address,undefined -g",
                "CMAKE_EXE_LINKER_FLAGS" : "-fsanitize=address,undefined",
                "CMAKE_INSTALL_PREFIX":"${sourceDir}/build/sanitize",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/coverage",
            "cacheVariables": {
                "ENABLE_COVERAGE": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "--coverage",
                "CMAKE_EXE_LINKER_FLAGS": "--coverage",
                "CMAKE_SHARED_LINKER_FLAGS": "--coverage",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        }
    ],
    "testPresets": [
        {
            "name" : "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "environment": {
                "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp:print_suppressions=1",
                "ASAN_OPTIONS": "detect_leaks=1"
            }
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        }
    ]
}





















































